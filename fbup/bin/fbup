#!/usr/bin/env ruby

## tip: to test run:
##   ruby -I ./lib bin/fbup
##     or
##   ruby -I fbup/lib fbup/bin/fbup


## note - quick hack - auto-add local football timezones
$LOAD_PATH.unshift( '/sports/sportdb/sport.db/leagues/lib' )
